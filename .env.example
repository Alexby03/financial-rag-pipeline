# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ANSWER_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=medium
OPENAI_REASONING_SUMMARY=auto
OPENAI_VISION_MODEL=gpt-4o

# Azure

## Mistral OCR 4 — required for PDF/Office/image ingest
# Resource host is enough; we append /providers/mistral/azure/ocr (or /v1/ocr on serverless).
MISTRAL_OCR_ENDPOINT=https://someresource.services.ai.azure.com
MISTRAL_OCR_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-4-0

## Cohere Rerank — leave blank to run without reranking
COHERE_API_BASE=https://someresource.services.ai.azure.com/providers/cohere/v2/rerank
COHERE_API_KEY=azure-endpoint-key
# Must match the Foundry deployment name exactly, or the endpoint answers 404.
COHERE_RERANK_MODEL=Cohere-rerank-v4.0-pro
RERANK_CANDIDATE_MULTIPLIER=4
RERANK_TIMEOUT_SECONDS=10
# Local BM25 over the dense pool, fused with Cohere (or vector) via RRF.
HYBRID_LEXICAL=true
RRF_K=60

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=ma_documents

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=localhost:9000
PRESIGNED_URL_TTL_SECONDS=900

# App
DEFAULT_TENANT_ID=default_tenant_test_corp_123
LOG_LEVEL=INFO
