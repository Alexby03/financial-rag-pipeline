# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ANSWER_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=medium
OPENAI_REASONING_SUMMARY=auto

# Azure — Cohere Rerank. Leave blank to run without reranking.
COHERE_API_BASE=https://someendpoint.models.ai.azure.com/v1
COHERE_API_KEY=azure-endpoint-key
# Must match the Foundry deployment name for project endpoints.
COHERE_RERANK_MODEL=rerank-multilingual-v3.0
RERANK_CANDIDATE_MULTIPLIER=4
RERANK_TIMEOUT_SECONDS=10

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=ma_documents

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=localhost:9000
PRESIGNED_URL_TTL_SECONDS=900

# App
DEFAULT_TENANT_ID=default_tenant_test_corp_123
LOG_LEVEL=INFO
